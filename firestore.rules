rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    // T-049/ERR-025: identidad admin por custom claim (UID), no por email.
    // El claim lo asigna exclusivamente Auth Admin en DEV/PROD; no se compara email.
    function isAdmin() {
      // get() evita error de evaluación cuando el token no trae el claim.
      return isAuth() && request.auth.token.get('admin', false) == true;
    }
    function canUpdateReserva() {
      return isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        resource.data.instructorId == request.auth.uid
      );
    }

    function maestraPre(packId) {
      return get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservasPack/$(packId)).data;
    }

    function maestraAfter(packId) {
      return getAfter(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservasPack/$(packId)).data;
    }

    function slotLibre(sub) {
      return !('reservaId' in sub) || sub.reservaId == null || sub.reservaId == '';
    }

    function sedePermitida(maestra, sedeId) {
      return !('packSnapshot' in maestra) ||
        !('sedesPermitidas' in maestra.packSnapshot) ||
        maestra.packSnapshot.sedesPermitidas.size() == 0 ||
        sedeId in maestra.packSnapshot.sedesPermitidas ||
        ('sedeId' in maestra && sedeId == maestra.sedeId);
    }

    function packPre(packId) {
      return get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/packs/$(packId)).data;
    }

    // ERR-053 / ADR-017: recargo vigente de la sede, autoridad del servidor.
    function sedePre(sedeId) {
      return get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/sedes/$(sedeId)).data;
    }

    function preciosMasterValidos(p, m) {
      return p is map &&
        p.precios is map &&
        m.preciosCongelados is map &&
        m.sedeId is string &&
        m.recargoSedeUnitario is number &&
        m.recargoSedeUnitario >= 0 &&
        cercaNumero(m.recargoSedeUnitario, sedePre(m.sedeId).get('recargo', 0)) &&
        cercaNumero(m.recargoSedeTotal, m.recargoSedeUnitario * p.precios.cursoIds.size()) &&
        cercaNumero(m.preciosCongelados.get('recargoSedeUnitario', 0), m.recargoSedeUnitario) &&
        cercaNumero(m.preciosCongelados.get('recargoSedeTotal', 0), m.recargoSedeTotal) &&
        m.precioBaseCongelado == p.precios.precioBaseTotal &&
        m.descuentoCongelado.tipo == p.precios.descuentoTipo &&
        m.descuentoCongelado.valor == p.precios.descuentoValor &&
        m.descuentoCongelado.monto == p.precios.descuentoMonto &&
        cercaNumero(m.precioTotalCongelado, p.precios.precioTotal + m.recargoSedeTotal) &&
        m.packSnapshot.cursoIds == p.precios.cursoIds &&
        m.preciosCongelados.cursoIds == p.precios.cursoIds &&
        m.preciosCongelados.preciosBase == p.precios.preciosBase &&
        m.preciosCongelados.preciosProrrateados == p.precios.preciosProrrateados &&
        m.preciosCongelados.comisionesInstructor == p.precios.comisionesInstructor &&
        m.preciosCongelados.comisionesProveedorMotoEmpresa == p.precios.comisionesProveedorMotoEmpresa &&
        m.preciosCongelados.comisionesProveedorMotoPropia == p.precios.comisionesProveedorMotoPropia &&
        m.preciosCongelados.deficitsMotoEmpresa == p.precios.deficitsMotoEmpresa &&
        m.preciosCongelados.deficitsMotoPropia == p.precios.deficitsMotoPropia &&
        m.preciosCongelados.motoIncluidaPorCurso == p.precios.motoIncluidaPorCurso &&
        m.preciosCongelados.permiteTraerMotoPropiaPorCurso == p.precios.permiteTraerMotoPropiaPorCurso &&
        m.preciosCongelados.teoricosIncluidos == p.precios.teoricosIncluidos &&
        m.preciosCongelados.teoricosIds == p.precios.teoricosIds &&
        m.preciosCongelados.teoricosPrecios == p.precios.teoricosPrecios;
    }

    function preciosChildValidos(pc, d) {
      let recargo = pc.get('recargoSedeUnitario', 0);
      return pc is map &&
        d.precioBaseOriginal is number &&
        d.comisionInstructor is number &&
        d.comisionProveedor is number &&
        d.deficitComision is number &&
        d.cursoId == pc.cursoIds[d.packCursoIndex] &&
        d.precio == pc.preciosProrrateados[d.packCursoIndex] + recargo &&
        d.precioBaseOriginal == pc.preciosBase[d.packCursoIndex] &&
        d.comisionInstructor == pc.comisionesInstructor[d.packCursoIndex] &&
        (
          (
            d.traeMoto == 'Sí' &&
            d.comisionProveedor == 0 &&
            d.proveedorId == null &&
            d.motoAsignadaId == null &&
            d.deficitComision == pc.deficitsMotoPropia[d.packCursoIndex] - recargo
          ) ||
          (
            d.traeMoto == 'No' &&
            // ERR-049: la variante "moto de la app" exige una moto concreta.
            // Sin ella la comision de empresa quedaba sin proveedor beneficiario.
            d.get('motoAsignadaId', null) != null &&
            d.comisionProveedor == pc.comisionesProveedorMotoEmpresa[d.packCursoIndex] &&
            d.deficitComision == pc.deficitsMotoEmpresa[d.packCursoIndex] - recargo
          )
        ) &&
        (pc.motoIncluidaPorCurso[d.packCursoIndex] == true || d.traeMoto == 'Sí') &&
        (pc.permiteTraerMotoPropiaPorCurso[d.packCursoIndex] == true || d.traeMoto == 'No');
    }

    // B-RESERVA-PRECIOS-CLIENTE: precio individual contra catálogo (cursos +
    // configuraciones + sedes). Tolerancia 0.02 por redondeo a centavos.
    function cercaNumero(a, b) {
      // Si algún valor no es numérico la resta falla y la regla deniega.
      return (a - b) * (a - b) < 0.0004;
    }

    function configApp() {
      return get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/configuraciones/main).data;
    }

    // T-098 / ADR-015 fase 1: proyección determinista de precio y recursos por
    // curso. Solo admin la escribe; el cliente la lee en `reservas.create`.
    function preciosCursoApp(cursoId) {
      return get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/preciosCurso/$(cursoId)).data;
    }

    function cursoTeoricoPre(cursoTeoricoId) {
      return get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/cursosTeoricos/$(cursoTeoricoId)).data;
    }

    function cursoTeoricoGratis(cursoId) {
      return cursoTeoricoPre(cursoId).get('precio', 1) == 0;
    }

    // B-TEORICO-MODULO-BYPASS / VENCIMIENTO: acceso vigente por usuario/curso.
    function accesoTeoricoVigente(cursoId) {
      let a = get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/accesosTeoricosResumen/$(request.auth.uid + '_' + cursoId)).data;
      let venc = a.get('vencimientoMs', null);
      return a.estado == 'Aprobado' && (venc == null || venc > request.time.toMillis());
    }

    function tasaFXVigente(cfg) {
      let tasa = cfg.get('monedaCobroClientes', 'EUR') == 'USD'
        ? cfg.get('tasaUSD', 1)
        : cfg.get('tasaEUR', 1);
      return tasa > 0 ? tasa : 1;
    }

    // T-098 / ADR-015 fase 1: valida snapshot, precio, pago total y comisiones
    // contra la variante `sedeId|traeMoto|sabeBicicleta` de `preciosCurso`.
    // Si el documento o la variante no existen, el acceso falla y la regla
    // deniega (fail-closed). Conserva la tolerancia de centavos `cercaNumero`.
    function precioIndividualValido(precios, d) {
      let ps = d.precioSnapshot;
      let precio = d.precio;
      let pagoMoneda = d.pagoTotalMoneda;
      let ves = d.pagoTotalVES;
      let comInstr = d.comisionInstructor;
      let comProv = d.comisionProveedor;
      let deficit = d.deficitComision;
      let traeMoto = d.traeMoto;
      let clave = d.sedeId + '|' + traeMoto + '|' + d.sabeBicicleta;
      let v = precios.variantes[clave];
      return precio is number &&
        pagoMoneda is number &&
        ves is number &&
        ves > 0 &&
        precio > 0 &&
        ps is map &&
        ps.version == 1 &&
        ps.moneda == 'USD' &&
        ps.cursoId == d.cursoId &&
        ps.sedeId == d.sedeId &&
        ps.traeMoto == traeMoto &&
        ps.sabeBicicleta == d.sabeBicicleta &&
        precios.version == 1 &&
        precios.cursoId == d.cursoId &&
        v is map &&
        cercaNumero(precio, v.precioTotal) &&
        cercaNumero(pagoMoneda, v.precioTotal) &&
        cercaNumero(ps.precioTotal, v.precioTotal) &&
        cercaNumero(ps.precioBase, v.precioBase) &&
        cercaNumero(ps.recargoSede, v.recargoSede) &&
        cercaNumero(ps.recargoSinBici, v.recargoSinBici) &&
        cercaNumero(ps.recargoAlquilerMoto, v.recargoAlquilerMoto) &&
        cercaNumero(ps.descuentoMotoPropia, v.descuentoMotoPropia) &&
        cercaNumero(ps.descuentoPromo, v.descuentoPromo) &&
        cercaNumero(comInstr, v.comisionInstructor) &&
        cercaNumero(ps.comisionInstructor, comInstr) &&
        cercaNumero(comProv, v.comisionProveedor) &&
        cercaNumero(ps.comisionProveedor, comProv) &&
        cercaNumero(deficit, v.deficitComision) &&
        cercaNumero(ps.deficitComision, deficit) &&
        cercaNumero(ps.tasaFX, v.tasaFX) &&
        cercaNumero(ves, v.pagoTotalVES) &&
        cercaNumero(ps.pagoTotalVES, ves) &&
        ps.sedeNombre == v.sedeNombre &&
        ps.guarenas == v.guarenas &&
        ps.monedaCobro == v.monedaCobro &&
        precios.motoIncluida == v.motoIncluida &&
        precios.permiteTraerMotoPropia == v.permiteTraerMotoPropia &&
        (traeMoto != 'Sí' || (
          comProv == 0 &&
          d.proveedorId == null &&
          d.motoAsignadaId == null
        )) &&
        (v.motoIncluida != false || traeMoto == 'Sí') &&
        (v.permiteTraerMotoPropia != false || traeMoto == 'No');
    }

    // B-02/T-054: contrato de campos de la reserva individual (web y PWA).
    // `pagosInstructorDia` y `pagosProveedorDia` quedan fuera de la allowlist:
    // son campos contables de admin y se deniegan si aparecen.
    function reservaIndividualCamposValida(d) {
      let pagadoInstructor = d.get('pagadoInstructor', null);
      let pagadoProveedor = d.get('pagadoProveedor', null);
      return d.keys().hasOnly([
        // Inscripción (validarInscripcionCompleta aplica .strip()).
        'nombre', 'apellido', 'cedula', 'diaNac', 'mesNac', 'anoNac', 'sexo',
        'estado', 'estadoId', 'municipio', 'municipioId', 'ciudad', 'ciudadId',
        'zona', 'correo', 'telefono', 'contactoEmergencia',
        'sabeBicicleta', 'traeMoto', 'tipoMoto', 'cursoId', 'sedeId',
        'condicionMedica', 'detalleCondicion',
        // Reserva.
        'userId', 'tipoCurso', 'fecha', 'fecha2', 'horaId', 'instructorId',
        'motoAsignadaId', 'fechaNacimiento', 'pagoTotalMoneda', 'pagoTotalVES',
        'pagoBanco', 'pagoTelefono', 'pagoCedula', 'pagoRef', 'id',
        'estadoPago', 'estadoCurso', 'precio', 'proveedorId', 'pin',
        'comisionInstructor', 'comisionProveedor', 'deficitComision',
        'precioSnapshot', 'origenReinscripcion', 'createdAt', 'lockId',
        // Compatibilidad PWA: solo se toleran en su valor inicial.
        'pagadoInstructor', 'pagadoProveedor', 'pagoProveedorId'
      ]) &&
        // Compatibilidad PWA: solo se tolera el estado inicial (ausente, false
        // o null). `true` y cualquier otro valor siguen denegados.
        (pagadoInstructor == null || pagadoInstructor == false) &&
        (pagadoProveedor == null || pagadoProveedor == false) &&
        d.get('pagoProveedorId', null) == null;
    }

    // Alineado con recursosHelpers.js: `sedes` ausente o null y lista vacía
    // significan "todas las sedes"; una lista no vacía debe contener la sede;
    // un tipo no-lista (corrupto) deniega.
    function reservaSedeCubierta(recurso, sedeId) {
      let sedes = recurso.get('sedes', null);
      return sedes == null || (sedes is list && (sedes.size() == 0 || sedeId in sedes));
    }

    function reservaInstructorDocValido(inst, sedeId) {
      return inst.get('activo', true) != false && reservaSedeCubierta(inst, sedeId);
    }

    function reservaMotoDocValida(moto, sedeId, proveedorId) {
      return moto.get('activo', true) != false &&
        reservaSedeCubierta(moto, sedeId) &&
        proveedorId == moto.get('proveedorId', null);
    }

    // El tutor público (espejo) manda; si no existe se usa el doc privado legacy.
    function reservaInstructorValido(sedeId, d) {
      let pub = exists(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/instructoresPublicos/$(d.instructorId))
        ? get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/instructoresPublicos/$(d.instructorId)).data
        : null;
      return pub != null ? reservaInstructorDocValido(pub, sedeId) : (
        exists(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/instructores/$(d.instructorId)) &&
        reservaInstructorDocValido(
          get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/instructores/$(d.instructorId)).data,
          sedeId
        )
      );
    }

    // T-098 / ADR-015 fase 1: allowlist del curso desde `preciosCurso`; no se
    // releen curso/config/sede en esta rama. Coherencia moto/proveedor y
    // existencia de la moto se conservan (fail-closed si el doc no existe).
    function reservaIndividualDestinoValido(precios, d) {
      let permitidos = precios.get('instructoresPermitidos', []);
      let motoId = d.get('motoAsignadaId', null);
      let proveedorId = d.get('proveedorId', null);
      let sedeId = d.sedeId;
      return reservaInstructorValido(sedeId, d) &&
        permitidos is list &&
        permitidos.size() > 0 &&
        d.instructorId in permitidos &&
        (
          motoId == null
            ? proveedorId == null
            : reservaMotoDocValida(
                get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/motos/$(motoId)).data,
                sedeId,
                proveedorId
              )
        ) &&
        (
          proveedorId == null ||
          get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/proveedores/$(proveedorId)).data.get('activo', true) != false
        );
    }

    // T-098 / ADR-015 fase 1: el precio individual se valida contra la variante
    // determinista de `preciosCurso` (sede|traeMoto|sabeBicicleta) en lugar de
    // releer curso + configuraciones + sedes. Un `get` sustituye las tres
    // lecturas y libera presupuesto de expresiones.
    function reservaIndividualValida(cursoId, d) {
      let precios = preciosCursoApp(cursoId);
      return reservaIndividualCamposValida(d) &&
        precioIndividualValido(precios, d) &&
        reservaIndividualDestinoValido(precios, d);
    }

    // B-04: la reserva individual solo puede consumir el lock determinista del
    // slot, vigente y del mismo usuario. El ID del lock y el de la reserva
    // deben describir el mismo slot; `get()` lee el estado previo, cuando la
    // transacción todavía no ha borrado el lock.
    function reservaLockIndividualValido(d) {
      let lock = get(/databases/$(database)/documents/locks/$(d.lockId)).data;
      return d.lockId == d.fecha + '_' + d.horaId + '_' + d.instructorId + '_' +
        (d.get('motoAsignadaId', null) == null ? 'sinmoto' : d.motoAsignadaId) &&
        lock.userId == request.auth.uid &&
        lock.expiresAt > request.time;
    }

    // B-04: la reserva y su espejo de ocupación nacen en la misma transacción.
    function espejoIndividualCreado(docId) {
      return getAfter(/databases/$(database)/documents/ocupacionConfirmada/$(docId)).data.userId == request.auth.uid;
    }

    // T-100 / ERR-052: un bloque ya iniciado no se puede reservar por SDK
    // directo. `horarios/{horaId}` es la autoridad: `inicioMin` (minutos desde
    // medianoche VET) y `tzOffsetMin` (offset VET respecto a UTC; hoy -240).
    // Fail-closed: sin doc o sin los campos, la reserva se deniega. El backfill
    // de `horarios` es precondición del deploy (ADR-016). D2 usa el mismo
    // `horaId` (invariante del flujo: un slot cubre ambos días).
    function instanteInicioVET(fecha, inicioMin, tzOffsetMin) {
      return timestamp.date(
        int(fecha.split('-')[0]),
        int(fecha.split('-')[1]),
        int(fecha.split('-')[2])
      ) + duration.value(inicioMin - tzOffsetMin, 'm');
    }

    function reservaSlotNoIniciado(d) {
      let h = get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/horarios/$(d.horaId)).data;
      let inicioMin = h.get('inicioMin', null);
      let tzOffsetMin = h.get('tzOffsetMin', null);
      return inicioMin is int &&
        tzOffsetMin is int &&
        d.fecha is string &&
        instanteInicioVET(d.fecha, inicioMin, tzOffsetMin) > request.time &&
        (
          d.get('fecha2', null) == null ||
          (
            d.fecha2 is string &&
            instanteInicioVET(d.fecha2, inicioMin, tzOffsetMin) > request.time
          )
        );
    }

    // B-PACK-SUBRESERVAS-METADATA: el dueño solo puede tocar el índice actual
    // (y únicamente su reservaId). Los demás índices deben quedar idénticos.
    function subReservasAjenasSinCambios(actual) {
      return (actual == 0 || resource.data.subReservas.size() <= 0 || request.resource.data.subReservas[0] == resource.data.subReservas[0]) &&
        (actual == 1 || resource.data.subReservas.size() <= 1 || request.resource.data.subReservas[1] == resource.data.subReservas[1]) &&
        (actual == 2 || resource.data.subReservas.size() <= 2 || request.resource.data.subReservas[2] == resource.data.subReservas[2]) &&
        (actual == 3 || resource.data.subReservas.size() <= 3 || request.resource.data.subReservas[3] == resource.data.subReservas[3]) &&
        (actual == 4 || resource.data.subReservas.size() <= 4 || request.resource.data.subReservas[4] == resource.data.subReservas[4]) &&
        (actual == 5 || resource.data.subReservas.size() <= 5 || request.resource.data.subReservas[5] == resource.data.subReservas[5]) &&
        (actual == 6 || resource.data.subReservas.size() <= 6 || request.resource.data.subReservas[6] == resource.data.subReservas[6]) &&
        (actual == 7 || resource.data.subReservas.size() <= 7 || request.resource.data.subReservas[7] == resource.data.subReservas[7]);
    }

    // B-ESPEJO-FANTASMA: el espejo debe coincidir campo a campo con la reserva.
    function espejoCoincideReserva(r) {
      // B-04: el espejo de ocupación solo replica los campos que gobiernan la
      // disponibilidad y el estado. Los campos financieros se leen de la
      // reserva autoritativa; compararlos aquí agotaba el presupuesto de 1000
      // expresiones al escribir reserva+espejo en la misma transacción.
      let rd = r.data;
      let d = request.resource.data;
      return d.userId == rd.userId &&
        d.fecha == rd.fecha &&
        d.get('fecha2', null) == rd.get('fecha2', null) &&
        d.horaId == rd.horaId &&
        d.instructorId == rd.instructorId &&
        d.get('motoAsignadaId', null) == rd.get('motoAsignadaId', null) &&
        d.traeMoto == rd.traeMoto &&
        d.sedeId == rd.sedeId &&
        d.estadoPago == rd.estadoPago &&
        (
          d.get('estadoCurso', null) == rd.get('estadoCurso', null) ||
          // Compatibilidad PWA vieja: el espejo puede omitir estadoCurso solo
          // cuando la reserva recién creada sigue en Pendiente.
          (!('estadoCurso' in d) && rd.get('estadoCurso', 'Pendiente') == 'Pendiente')
        ) &&
        d.get('proveedorId', null) == rd.get('proveedorId', null) &&
        d.get('comisionProveedor', 0) == rd.get('comisionProveedor', 0) &&
        // T-100 / ERR-052: el espejo es obligatorio en la misma transacción
        // (B-04), así que el guard de bloque ya iniciado vive aquí para no
        // agotar el presupuesto de expresiones de `reservas.create`. El admin
        // queda exento por la rama `isAdmin()` del create del espejo.
        reservaSlotNoIniciado(rd);
    }

    // B-FX-CONCILIACION: la maestra congela la tasa y el VES desde la configuración.
    function fxMasterValido(cfg, m) {
      let fx = m.get('fxCongelado', null);
      let tasa = tasaFXVigente(cfg);
      return fx is map &&
        fx.version == 1 &&
        fx.monedaBase == 'USD' &&
        fx.monedaCobro == cfg.get('monedaCobroClientes', 'EUR') &&
        cercaNumero(fx.tasaFX, tasa) &&
        cercaNumero(fx.pagoTotalVES, m.pagoTotalVES) &&
        cercaNumero(m.pagoTotalVES, m.precioTotalCongelado * tasa);
    }

    // B-01 / ERR-029 / T-062: la maestra de pack nace SIEMPRE impaga, con
    // vencimiento acotado por el `vencimientoDias` del pack (autoridad admin)
    // y con `subReservas` coherente con el snapshot de cursos. Sin esto, un
    // estudiante podía autoaprobar su pack y luego crear children Aprobadas.
    function diasVencimientoPack(p) {
      let d = p.get('vencimientoDias', 60);
      return d is int && d > 0 && d <= 730 ? d : 60;
    }

    function vencimientoMasterValido(p, m) {
      let v = m.get('vencimiento', null);
      // +1 día de tolerancia por desfase de reloj del cliente al congelar.
      return v is timestamp &&
        v > request.time &&
        v <= request.time + duration.value(diasVencimientoPack(p), 'd') + duration.value(1, 'd');
    }

    // `sedesPermitidas` del pack define la cobertura de sedes de la compra.
    // Semántica (compatibilidad con packs legacy):
    //   - lista vacía => sin restricción por sede (`sedePermitida` acepta todas).
    //   - `null`/ausente => se trata como lista vacía (sin restricción).
    //   - lista no vacía => solo esas sedes; cualquier otro tipo se rechaza.
    // `packSedesTipoValido` solo rechaza un tipo corrupto (ni null ni list).
    function packSedesTipoValido(p) {
      let sedes = p.get('sedesPermitidas', null);
      return sedes == null || sedes is list;
    }

    function sedesPackDe(p) {
      let sedes = p.get('sedesPermitidas', null);
      return sedes is list ? sedes : [];
    }

    // `sedesPermitidas` de la maestra no puede ampliar las sedes del pack y,
    // si el pack restringe, el `sedeId` de la maestra debe estar dentro del
    // pack. Además, con pack restringido el snapshot no puede quedar vacío:
    // `sedePermitida()` (líneas 32-38) interpreta `[]` como "sin restricción",
    // así que un snapshot vacío habilitaba agendar el child en cualquier sede
    // (residual ERR-029). Legacy (pack `null`/`[]`): snapshot vacío y cualquier
    // sede siguen permitidos.
    function sedesMasterValidas(p, m) {
      let sedesPack = sedesPackDe(p);
      let sedesMaster = m.get('packSnapshot', {}).get('sedesPermitidas', null);
      return packSedesTipoValido(p) && (
        sedesPack.size() == 0 ||
        (
          sedesMaster is list &&
          sedesMaster.size() > 0 &&
          sedesMaster.toSet().difference(sedesPack.toSet()).size() == 0 &&
          m.get('sedeId', null) in sedesPack
        )
      );
    }

    // Una subReserva por curso del snapshot; la primera apunta al child
    // determinista `<packId>_sub_0` que se crea en la misma transacción.
    function subReservasMasterCoherentes(packReservaId, m) {
      let ids = m.get('packSnapshot', {}).get('cursoIds', []);
      return ids is list &&
        ids.size() > 0 &&
        m.get('subReservas', []) is list &&
        m.subReservas.size() == ids.size() &&
        m.subReservas[0].cursoId == ids[0] &&
        m.subReservas[0].reservaId == m.get('cursoReservaId', null) &&
        m.subReservas[0].reservaId == packReservaId + '_sub_0';
    }

    // B-01: la child de pack solo puede nacer con su espejo de ocupación.
    function espejoChildCreado(reservaId, childUserId) {
      return getAfter(/databases/$(database)/documents/ocupacionConfirmada/$(reservaId)).data.userId == childUserId;
    }

    // D1: la moto de la child manda. Si hay moto asignada debe existir, estar
    // activa, pertenecer al `proveedorId` declarado y su proveedor debe estar
    // activo. Si no hay moto asignada (moto propia o curso sin moto) no se leen
    // `motos` ni `proveedores` y `proveedorId` debe ser null.
    function motoChildCoherente(moto, proveedorId) {
      let proveedorMotoId = moto.get('proveedorId', null);
      return moto.get('activo', true) != false &&
        proveedorId == proveedorMotoId &&
        (
          proveedorMotoId == null ||
          get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/proveedores/$(proveedorMotoId)).data.get('activo', true) != false
        );
    }

    function motoYProveedorChildValidos(d) {
      let motoId = d.get('motoAsignadaId', null);
      let proveedorId = d.get('proveedorId', null);
      return motoId == null
        ? proveedorId == null
        : motoChildCoherente(
            get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/motos/$(motoId)).data,
            proveedorId
          );
    }

    // Presupuesto de expresiones: la rama de agendamiento llamaba a
    // `maestraPre`/`maestraAfter` 14+ veces. Se enlazan una sola vez para
    // dejar margen al chequeo de proveedor sin superar las 1000 expresiones.
    function packChildAgendaValida(packId, childId, d) {
      let pre = maestraPre(packId);
      let post = maestraAfter(packId);
      return exists(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservasPack/$(packId)) &&
        // B-01: child Aprobada solo la crea el dueño del pack o un admin, y
        // siempre con el child en Pendiente.
        (request.auth.uid == pre.userId || isAdmin()) &&
        (isAdmin() || d.estadoCurso == 'Pendiente') &&
        pre.userId == d.userId &&
        pre.estadoPago == 'Aprobado' &&
        pre.estado == 'activo' &&
        (
          !('vencimiento' in pre) ||
          pre.get('vencimiento', null) == null ||
          !(pre.vencimiento is timestamp) ||
          pre.vencimiento > request.time
        ) &&
        d.packCursoIndex == pre.get('cursoActual', 0) &&
        d.packCursoIndex < pre.subReservas.size() &&
        d.packCursoIndex < pre.packSnapshot.cursoIds.size() &&
        pre.subReservas.size() == pre.packSnapshot.cursoIds.size() &&
        slotLibre(pre.subReservas[d.packCursoIndex]) &&
        d.cursoId == pre.packSnapshot.cursoIds[d.packCursoIndex] &&
        espejoChildCreado(childId, d.userId) &&
        post.cursoReservaId == childId &&
        post.subReservas[d.packCursoIndex].reservaId == childId &&
        preciosChildValidos(post.preciosCongelados, d) &&
        cercaNumero(d.pagoTotalVES, d.precio * post.fxCongelado.tasaFX) &&
        (
          !isAdmin() ||
          (
            d.origen == 'reparacion_admin' &&
            d.creadoPorUid == request.auth.uid &&
            d.motivoReparacion is string &&
            d.motivoReparacion.size() > 0
          )
        ) &&
        motoYProveedorChildValidos(d) &&
        sedePermitida(pre, d.sedeId);
    }

    function esLockCorrupto(lockData) {
      return !(
        'userId' in lockData &&
        'instructorId' in lockData &&
        'fecha' in lockData &&
        'horaId' in lockData &&
        'expiresAt' in lockData &&
        lockData.userId != null &&
        lockData.instructorId != null &&
        lockData.fecha != null &&
        lockData.horaId != null &&
        lockData.expiresAt != null
      );
    }

    match /locks/{lockId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.expiresAt is timestamp &&
                      request.resource.data.expiresAt <= request.time + duration.value(900, 's') &&
                      (
                        !exists(/databases/$(database)/documents/locks/$(lockId)) ||
                        get(/databases/$(database)/documents/locks/$(lockId)).data.expiresAt < request.time
                      ); 
      allow update: if isAuth() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        ) ||
        (
          // B-LOCKS-EXPIRADOS-BLOQUEAN: toma de un lock vencido de otro usuario.
          resource.data.expiresAt < request.time &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt <= request.time + duration.value(900, 's')
        )
      );
      allow delete: if isAuth() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /ocupacionTemporal/{lockId} {
      allow read: if isAuth();
      allow create: if isAuth() && 
                      request.resource.data.expiresAt is timestamp &&
                      request.resource.data.expiresAt <= request.time + duration.value(900, 's') &&
                      getAfter(/databases/$(database)/documents/locks/$(lockId)).data.userId == request.auth.uid;
      allow update: if isAuth() && (
        (
          exists(/databases/$(database)/documents/locks/$(lockId)) &&
          get(/databases/$(database)/documents/locks/$(lockId)).data.userId == request.auth.uid &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        ) ||
        (
          // Toma del espejo temporal cuando el lock ya venció.
          resource.data.expiresAt < request.time &&
          getAfter(/databases/$(database)/documents/locks/$(lockId)).data.userId == request.auth.uid &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt <= request.time + duration.value(900, 's')
        )
      );
      allow delete: if isAuth() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /ocupacionConfirmada/{docId} {
      allow read: if isAuth();
      allow create: if isAdmin() || (
        isAuth() &&
        espejoCoincideReserva(getAfter(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(docId)))
      );
      allow update: if isAdmin() || (
        isAuth() &&
        (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.instructorId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoCurso']) &&
        request.resource.data.estadoCurso in ['Pendiente', 'En Curso', 'Aprobado', 'Completado', 'Cancelado']
      );
      allow delete: if isAdmin();
    }

    // B-PACK-DOBLE-COMPRA: lock por usuario para el pack de sesiones activo.
    // El servicio lo escribe dentro de la transacción de compra.
    match /packActivo/{uid} {
      allow read: if isAuth() && (isAdmin() || request.auth.uid == uid);
      allow create, update: if isAuth() &&
        request.auth.uid == uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.packReservaId is string;
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data {

      // ADR-009 fase 2: `main` operativa para autenticados; `privada` solo admin.
      match /configuraciones/{docId} {
        allow read: if isAdmin() || (isAuth() && docId == 'main');
        allow write: if isAdmin();
      }
      match /sedes/{docId} { allow read: if isAuth(); allow write: if isAdmin(); }
      // T-048 / FT-031: catálogos geográficos normalizados. Lectura pública
      // (sin PII, necesaria para el registro anónimo de FT-048) y escritura
      // exclusiva admin; soft delete vía `activo:false`.
      match /estados/{docId} { allow read: if true; allow write: if isAdmin(); }
      match /municipios/{docId} { allow read: if true; allow write: if isAdmin(); }
      match /ciudades/{docId} { allow read: if true; allow write: if isAdmin(); }
      match /horarios/{docId} { allow read: if isAuth(); allow write: if isAdmin(); }
      match /cursos/{docId} { allow read: if true; allow write: if isAdmin(); }
      // T-098 / ADR-015 fase 1: proyección de precio por curso (variantes por
      // sede/moto/bici). Solo lectura autenticada; escritura exclusiva admin
      // (backfill). El cliente nunca puede alterar la matriz de precios.
      match /preciosCurso/{docId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
      match /instructores/{docId} {
        allow read: if isAuth() && (isAdmin() || docId == request.auth.uid);
        allow create, delete: if isAdmin();
        // B-INSTRUCTOR-PERFIL-RULES: el propio instructor puede editar solo
        // su perfil visible. Cédula, rol, permisos y flags siguen en admin.
        allow update: if isAdmin() || (
          isAuth() &&
          docId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'apellido', 'telefono', 'especialidad', 'bio', 'foto', 'updatedAt'
          ])
        );
      }
      match /instructoresPublicos/{docId} {
        allow read: if isAuth();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isAuth() &&
          docId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'apellido', 'especialidad', 'bio', 'foto', 'updatedAt'
          ])
        );
      }
      match /proveedores/{docId} {
        allow read: if isAuth() && (isAdmin() || docId == request.auth.uid);
        allow create, update, delete: if isAdmin();
      }
      // Espejo público de proveedores: solo autenticados (catálogo interno);
      // nunca lectura anónima. Escritura solo admin.
      match /proveedoresPublicos/{docId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
      match /motos/{docId} {
        allow read: if isAuth();
        allow create: if isAuth() && (
          isAdmin() || request.resource.data.proveedorId == request.auth.uid
        );
        allow update: if isAuth() && (
          isAdmin() || (
            resource.data.proveedorId == request.auth.uid &&
            // B-08: el proveedor no puede transferir la moto a otro UID.
            request.resource.data.proveedorId == resource.data.proveedorId
          )
        );
        allow delete: if isAdmin();
      }
      // T-057: el doc admins solo lo lee un admin; no expone roster a estudiantes.
      match /admins/{docId} { allow read: if isAdmin(); allow write: if isAdmin(); }

      match /reservas/{docId} {
        // ERR-057: permitir leer documentos inexistentes (resource == null) para
        // chequeos de existencia dentro de transacciones (p.ej. child de pack).
        // No expone datos: solo confirma que el doc no existe. Los docs existentes
        // conservan dueño/instructor/admin.
        allow read: if isAuth() && (
          resource == null ||
          isAdmin() || 
          resource.data.userId == request.auth.uid || 
          resource.data.instructorId == request.auth.uid ||
          request.auth.uid in resource.data.get('implicadosIds', [])
        );

        allow create: if isAuth() && 
                      (request.resource.data.userId == request.auth.uid || isAdmin()) &&
                      request.resource.data.precio > 0 &&
                      (
                        (
                          !('tipoReserva' in request.resource.data) &&
                          request.resource.data.userId == request.auth.uid &&
                          request.resource.data.estadoPago == 'Pendiente' &&
                          (
                            !('estadoCurso' in request.resource.data) ||
                            request.resource.data.estadoCurso == 'Pendiente'
                          ) &&
                          request.resource.data.cursoId is string &&
                          request.resource.data.sedeId is string &&
                          request.resource.data.instructorId is string &&
                          request.resource.data.get('lockId', null) is string &&
                          reservaLockIndividualValido(request.resource.data) &&
                          espejoIndividualCreado(docId) &&
                          request.resource.data.get('id', null) == docId &&
                          reservaIndividualValida(
                            request.resource.data.cursoId,
                            request.resource.data
                          )
                        ) ||
                        (
                          request.resource.data.tipoReserva == 'pack_sub' &&
                          !('sesionTotalInicio' in request.resource.data) &&
                          !('pausaTotalAcumulada' in request.resource.data) &&
                          request.resource.data.packReservaId is string &&
                          request.resource.data.packCursoIndex is int &&
                          request.resource.data.packCursoIndex >= 0 &&
                          request.resource.data.cursoId is string &&
                          request.resource.data.estadoCurso == 'Pendiente' &&
                          docId == request.resource.data.packReservaId + '_sub_' + string(request.resource.data.packCursoIndex) &&
                          (
                            // PACK-CHILD-C: compra (maestra nueva, primera child Pendiente)
                            (
                              request.resource.data.estadoPago == 'Pendiente' &&
                              request.resource.data.userId == request.auth.uid &&
                              request.resource.data.packCursoIndex == 0 &&
                              !exists(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservasPack/$(request.resource.data.packReservaId)) &&
                              maestraAfter(request.resource.data.packReservaId).userId == request.auth.uid &&
                              maestraAfter(request.resource.data.packReservaId).estadoPago == 'Pendiente' &&
                              maestraAfter(request.resource.data.packReservaId).estado == 'activo' &&
                              maestraAfter(request.resource.data.packReservaId).get('cursoActual', 0) == 0 &&
                              maestraAfter(request.resource.data.packReservaId).cursoReservaId == docId &&
                              maestraAfter(request.resource.data.packReservaId).subReservas[0].reservaId == docId &&
                              preciosChildValidos(maestraAfter(request.resource.data.packReservaId).preciosCongelados, request.resource.data) &&
                              cercaNumero(request.resource.data.pagoTotalVES, request.resource.data.precio * maestraAfter(request.resource.data.packReservaId).fxCongelado.tasaFX) &&
                              maestraAfter(request.resource.data.packReservaId).subReservas.size() == maestraAfter(request.resource.data.packReservaId).packSnapshot.cursoIds.size() &&
                              maestraAfter(request.resource.data.packReservaId).packSnapshot.cursoIds.size() > 0 &&
                              request.resource.data.cursoId == maestraAfter(request.resource.data.packReservaId).packSnapshot.cursoIds[0] &&
                              espejoChildCreado(docId, request.resource.data.userId) &&
                              sedePermitida(maestraAfter(request.resource.data.packReservaId), request.resource.data.sedeId) &&
                              // D1: moto/proveedor coherentes y proveedor activo.
                              motoYProveedorChildValidos(request.resource.data)
                            ) ||
                            // PACK-CHILD-C: agendamiento o reparación admin
                            (
                              request.resource.data.estadoPago == 'Aprobado' &&
                              packChildAgendaValida(
                                request.resource.data.packReservaId,
                                docId,
                                request.resource.data
                              )
                            )
                          )
                        )
                      );

        allow update: if isAuth() && (
          isAdmin() ||
          (
            resource.data.instructorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pausaActiva',
              'pausas',
              'pausaTotalAcumulada',
              'tiempoEfectivo',
              'moduloEnProgreso',
              'modulosEstado',
              'sesionDiariaInicio',
              'sesionDiariaLimite',
              'sesionTotalInicio',
              'sesionTotalLimite',
              'diaActual',
              'tiempoAcumuladoHastaD1',
              'pausasHastaD1',
              'reservaActiva',
              'reservaRestante',
              'reservaInicio',
              'reservaRestanteInicial',
              'estadoCurso',
              'emergencia'
            ])
          ) ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.precio == resource.data.precio &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pagoRef',
              'pagoBanco',
              'pagoTelefono',
              'pagoCedula',
              'estadoPago'
            ]) &&
            (
              (resource.data.estadoPago == 'Pendiente' && request.resource.data.estadoPago == 'Pendiente') ||
              (
                resource.data.estadoPago == 'Rechazado' &&
                request.resource.data.estadoPago == 'Pendiente' &&
                (!('intentosCorreccion' in resource.data) || resource.data.intentosCorreccion < 3)
              )
            )
          ) ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estudiantePresente'
            ])
          )
        );

        allow delete: if false;
      }

      match /movimientos/{docId} {
        allow read: if isAdmin();
        allow create: if isAdmin() &&
          request.resource.data.tipo in ['ingreso', 'egreso'] &&
          request.resource.data.monto is number &&
          request.resource.data.monto > 0 &&
          request.resource.data.categoria is string &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.estado == 'confirmado';
        allow update, delete: if false;
      }

      match /notificaciones/{docId} {
        allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
        allow create: if isAuth() && (isAdmin() || request.auth.uid == request.resource.data.userId);
        allow update: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
        allow delete: if isAdmin();
      }

            match /progresoInscripcion/{docId} {
        allow get: if true;
        allow list: if false;
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        // A6: adopción de docs huérfanos solo si correo coincide Y pin está vacío
        allow update: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.correo == request.auth.token.email && resource.data.pin == '')
        );
        allow delete: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.correo == request.auth.token.email && resource.data.pin == '')
        );
      }
      match /pagosStaff/{pagoId} {
        allow read: if isAuth() && (isAdmin() || resource.data.staffId == request.auth.uid);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
      match /metodosPago/{metodoId} {
        allow read: if isAuth(); allow write: if isAdmin();
      }

      // T-060 / ERR-027: corte del maestro `packs`. Ya no se expone a anónimos:
      // el catálogo público lee la proyección `packsPublicos` (T-060). El
      // frontend que aún use `packs` debe migrar a `packsPublicos` antes de
      // desplegar estas reglas (ver riesgo DEV en el reporte del corte).
      match /packs/{packId} { allow read: if isAuth(); allow write: if isAdmin(); }

      // T-060 / ERR-027: proyección pública de packs (sin comisiones, déficits ni
      // datos internos). Lectura anónima para el catálogo público; escritura solo admin.
      match /packsPublicos/{packId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /reservasPack/{packReservaId} {
        allow read: if isAuth() && (
          isAdmin() || 
          resource.data.userId == request.auth.uid ||
          (
            resource.data.cursoReservaId != null &&
            get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(resource.data.cursoReservaId)).data.instructorId == request.auth.uid
          )
        );
        allow create: if isAuth() && 
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.estado == 'activo' &&
          request.resource.data.cursoActual == 0 &&
          // B-01 / ERR-029: el pack nace impago; solo el admin lo aprueba.
          request.resource.data.estadoPago == 'Pendiente' &&
          request.resource.data.subReservas is list &&
          request.resource.data.subReservas.size() > 0 &&
          request.resource.data.precioTotalCongelado > 0 &&
          request.resource.data.packId is string &&
          request.resource.data.pagoTotalVES is number &&
          request.resource.data.pagoTotalVES > 0 &&
          // B-01: total cobrado == total congelado del snapshot admin.
          cercaNumero(request.resource.data.pagoTotalMoneda, request.resource.data.precioTotalCongelado) &&
          preciosMasterValidos(packPre(request.resource.data.packId), request.resource.data) &&
          fxMasterValido(configApp(), request.resource.data) &&
          vencimientoMasterValido(packPre(request.resource.data.packId), request.resource.data) &&
          subReservasMasterCoherentes(packReservaId, request.resource.data) &&
          sedesMasterValidas(packPre(request.resource.data.packId), request.resource.data);
        allow update: if isAuth() && (
          isAdmin() ||
          (
            // RAMA 1 - DUENO: agendar (solo reservaId del curso actual)
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'subReservas', 'cursoReservaId'
            ]) &&
            resource.data.get('cursoActual', 0) is int &&
            resource.data.get('cursoActual', 0) >= 0 &&
            resource.data.get('cursoActual', 0) < resource.data.subReservas.size() &&
            request.resource.data.subReservas.size() == resource.data.subReservas.size() &&
            subReservasAjenasSinCambios(resource.data.get('cursoActual', 0)) &&
            request.resource.data.subReservas[resource.data.get('cursoActual', 0)].diff(resource.data.subReservas[resource.data.get('cursoActual', 0)]).affectedKeys().hasOnly(['reservaId']) &&
            request.resource.data.subReservas[resource.data.get('cursoActual', 0)].cursoId == resource.data.subReservas[resource.data.get('cursoActual', 0)].cursoId &&
            (
              (
                resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) != null &&
                resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) != '' &&
                request.resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) == resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) &&
                request.resource.data.cursoReservaId == resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null)
              ) ||
              (
                (resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) == null ||
                 resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) == '') &&
                request.resource.data.subReservas[resource.data.get('cursoActual', 0)].get('reservaId', null) == request.resource.data.cursoReservaId &&
                request.resource.data.cursoReservaId != null &&
                !exists(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(request.resource.data.cursoReservaId)) &&
                getAfter(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(request.resource.data.cursoReservaId)).data.userId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(request.resource.data.cursoReservaId)).data.tipoReserva == 'pack_sub' &&
                getAfter(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(request.resource.data.cursoReservaId)).data.packReservaId == packReservaId &&
                getAfter(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(request.resource.data.cursoReservaId)).data.packCursoIndex == resource.data.get('cursoActual', 0)
              )
            )
          ) ||
          (
            // RAMA 2 - DUENO: corregir referencia de pago (pack rechazado)
            resource.data.userId == request.auth.uid &&
            resource.data.estadoPago == 'Rechazado' &&
            request.resource.data.estadoPago == 'Pendiente' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pagoRef', 'estadoPago', 'rechazadoEn'
            ]) &&
            request.resource.data.pagoRef is string &&
            request.resource.data.pagoRef.size() == 4 &&
            resource.data.cursoReservaId != null &&
            get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(resource.data.cursoReservaId)).data.estadoPago == 'Rechazado' &&
            get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(resource.data.cursoReservaId)).data.get('intentosCorreccion', 0) < 3
          ) ||
          (
            // RAMA 3 - TUTOR ASIGNADO: avance y vencimiento
            resource.data.cursoReservaId != null &&
            get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservas/$(resource.data.cursoReservaId)).data.instructorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'subReservas', 'cursoActual', 'estado'
            ]) &&
            request.resource.data.cursoActual >= resource.data.cursoActual &&
            request.resource.data.cursoActual <= resource.data.cursoActual + 1 &&
            (
              resource.data.estado == request.resource.data.estado ||
              (resource.data.estado == 'activo' && request.resource.data.estado == 'completado') ||
              (
                resource.data.estado == 'activo' &&
                request.resource.data.estado == 'vencido' &&
                resource.data.vencimiento is timestamp &&
                resource.data.vencimiento < request.time
              )
            )
          )
        );
        allow delete: if false;
      }

      match /cursosTeoricos/{cursoId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /modulosTeoricos/{moduloId} {
        allow read: if isAuth() && (
          isAdmin() ||
          cursoTeoricoGratis(resource.data.cursoId) ||
          accesoTeoricoVigente(resource.data.cursoId)
        );
        allow write: if isAdmin();
      }

      match /quizzesTeoricos/{quizId} {
        allow read: if isAuth() && (
          isAdmin() ||
          cursoTeoricoGratis(resource.data.cursoId) ||
          accesoTeoricoVigente(resource.data.cursoId)
        );
        allow write: if isAdmin();
      }

      match /packsTeoricos/{packId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /recursos/{recursoId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /accesosTeoricos/{accesoId} {
        allow read: if isAuth() && (
          isAdmin() || resource.data.userId == request.auth.uid
        );
        allow create: if isAuth() && (
          // Rama 1: usuario compra su propio acceso standalone
          (
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.cursoTeoricoId is string &&
            request.resource.data.origen == 'standalone' &&
            request.resource.data.packReservaId == null &&
            request.resource.data.estadoPago == 'Pendiente' &&
            request.resource.data.precio is number &&
            request.resource.data.precio > 0 &&
            request.resource.data.comisionInstructor == 0 &&
            request.resource.data.comisionProveedor == 0 &&
            cercaNumero(request.resource.data.precio, cursoTeoricoPre(request.resource.data.cursoTeoricoId).precio) &&
            request.resource.data.moneda == cursoTeoricoPre(request.resource.data.cursoTeoricoId).get('moneda', 'USD') &&
            request.resource.data.esAccesoVitalicio == (cursoTeoricoPre(request.resource.data.cursoTeoricoId).get('duracionAcceso', '') == 'vida') &&
            !('logrosCurso' in request.resource.data) &&
            !('progreso' in request.resource.data)
          ) ||
          // Rama 2: admin crea acceso por aprobación de pack
          (
            isAdmin() &&
            request.resource.data.origen == 'pack' &&
            request.resource.data.estadoPago == 'Aprobado' &&
            request.resource.data.precio == 0 &&
            request.resource.data.packReservaId != null &&
            exists(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservasPack/$(request.resource.data.packReservaId)) &&
            get(/databases/$(database)/documents/artifacts/motoescuela-pro-v1/public/data/reservasPack/$(request.resource.data.packReservaId)).data.userId == request.resource.data.userId
          )
        );
        allow update: if isAuth() && (
          isAdmin() ||
          // T2.7 - Rama A: progreso del estudiante (sin tocar estadoPago)
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.precio == resource.data.precio &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'progreso',
              'logrosCurso',
              'streak'
            ])
          ) ||
          // T2.7 - Rama B: corrección de referencia (Rechazado -> Pendiente)
          // El estudiante NO puede borrar motivoRechazo, ni cambiar intentosCorreccion.
          // Freno táctico: solo si (intentosCorreccion actual) < 3.
          (
            resource.data.userId == request.auth.uid &&
            resource.data.estadoPago == 'Rechazado' &&
            (!('intentosCorreccion' in resource.data) || resource.data.intentosCorreccion < 3) &&
            request.resource.data.estadoPago == 'Pendiente' &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.precio == resource.data.precio &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pagoRef',
              'pagoBanco',
              'pagoTelefono',
              'pagoCedula',
              'estadoPago',
              'updatedAt'
            ])
          )
        );
        allow delete: if false;
      }
      // B-TEORICO-MODULO-BYPASS: índice admin-only que usan las reglas de
      // módulos/quizzes. No es escribible por el estudiante.
      match /accesosTeoricosResumen/{resumenId} {
        allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
        allow write: if isAdmin();
      }
      match /usuarios/{uid} {
        allow read: if isAuth() && (isAdmin() || request.auth.uid == uid);
        allow create: if isAuth() && request.auth.uid == uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.correo == request.auth.token.email &&
          request.resource.data.keys().hasOnly([
            'uid', 'correo', 'cedula', 'nombre', 'apellido',
            'telefono', 'contactoEmergencia', 'fechaNacimiento',
            'sexo', 'estado', 'estadoId', 'municipio', 'municipioId',
            'ciudad', 'ciudadId', 'zona', 'condicionMedica', 'detalleCondicion',
            'capacidades', 'contadores', 'metricas', 'createdAt', 'updatedAt'
          ]);
        allow update: if isAuth() && (
          isAdmin() ||
          (
            request.auth.uid == uid &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.cedula == resource.data.cedula &&
            request.resource.data.correo == resource.data.correo &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'nombre', 'apellido', 'telefono', 'contactoEmergencia',
              'fechaNacimiento', 'sexo', 'estado', 'estadoId',
              'municipio', 'municipioId', 'ciudad', 'ciudadId', 'zona',
              'condicionMedica', 'detalleCondicion',
              'capacidades', 'contadores', 'metricas', 'updatedAt'
            ])
          )
        );
        allow delete: if isAdmin();
      }

      
      match /logrosUsuario/{uid} {
        allow read: if isAuth() && (isAdmin() || request.auth.uid == uid);
        allow create: if isAuth() &&
          request.auth.uid == uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.logros is list &&
          request.resource.data.stats is map &&
          request.resource.data.streak is map;
        allow update: if isAuth() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'logros',
            'streak',
            'stats'
          ]);
        allow delete: if false;
      }
    }

    match /audit_logs/{logId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    // B-D2-AUDITORIA: bitácora append-only de reprogramaciones.
    // Solo admin lee y crea; update/delete siempre denegados.
    match /auditoriaReprogramaciones/{eventoId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.reservaId is string &&
        request.resource.data.tipo is string &&
        request.resource.data.autorId is string &&
        request.resource.data.antes is map &&
        request.resource.data.despues is map &&
        request.resource.data.inmutable == true &&
        request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // D2-FINANZAS: deuda del proveedor con la app y ledger append-only.
    // El proveedor lee solo sus documentos; el admin crea/actualiza; nunca delete.
    match /deudasProveedor/{deudaId} {
      allow read: if isAdmin() || (
        isAuth() &&
        'proveedorId' in resource.data &&
        resource.data.proveedorId == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /ledgerProveedor/{asientoId} {
      allow read: if isAdmin() || (
        isAuth() &&
        'proveedorId' in resource.data &&
        resource.data.proveedorId == request.auth.uid
      );
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // T-025 / FT-001: deuda del tutor saliente por relevo post-pago y ledger
    // append-only. El tutor lee solo sus documentos; el admin crea/actualiza.
    match /deudasInstructor/{deudaId} {
      allow read: if isAdmin() || (
        isAuth() &&
        'instructorId' in resource.data &&
        resource.data.instructorId == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /ledgerInstructor/{asientoId} {
      allow read: if isAdmin() || (
        isAuth() &&
        'instructorId' in resource.data &&
        resource.data.instructorId == request.auth.uid
      );
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // El proveedor reporta un pago de deuda; el admin lo confirma.
    match /solicitudesPagoDeuda/{solicitudId} {
      allow read: if isAdmin() || (
        isAuth() &&
        'proveedorId' in resource.data &&
        resource.data.proveedorId == request.auth.uid
      );
      allow create: if isAuth() &&
        request.resource.data.proveedorId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.deudaId is string &&
        request.resource.data.monto is number &&
        request.resource.data.monto > 0 &&
        // B-07: la deuda debe existir, ser del proveedor, estar pendiente y cubrir el monto.
        exists(/databases/$(database)/documents/deudasProveedor/$(request.resource.data.deudaId)) &&
        get(/databases/$(database)/documents/deudasProveedor/$(request.resource.data.deudaId)).data.proveedorId == request.auth.uid &&
        get(/databases/$(database)/documents/deudasProveedor/$(request.resource.data.deudaId)).data.estado == 'pendiente' &&
        request.resource.data.monto <= get(/databases/$(database)/documents/deudasProveedor/$(request.resource.data.deudaId)).data.saldo;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /bloqueosGlobales/{bloqueoId} {
      allow read: if true;
      allow create: if isAuth() && (
        isAdmin() || request.resource.data.proveedorId == request.auth.uid
      );
      allow update, delete: if isAuth() && (
        isAdmin() || resource.data.proveedorId == request.auth.uid
      );
    }

    match /bloqueosAdmin/{bloqueoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bloqueosInstructores/{bloqueoId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isAdmin() || request.resource.data.instructorId == request.auth.uid
      );
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.instructorId == request.auth.uid &&
          request.resource.data.instructorId == resource.data.instructorId
        )
      );
      allow delete: if isAdmin();
    }

    match /proveedores/{proveedorUid}/bloqueos/{bloqueoId} {
      allow read: if true;
      allow create: if isAuth() && (
        isAdmin() || request.auth.uid == proveedorUid
      );
      allow update, delete: if isAuth() && (
        isAdmin() || request.auth.uid == proveedorUid
      );
    }

    match /cedulasRegistradas/{cedula} {
      allow get: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /informacionPublica/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
  }
}
